{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "WGR_EXAMPLES": "ON"
      }
    },
    {
      "name": "headless-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "WGR_HEADLESS": "ON",
        "WGR_TESTS": "ON"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/mingw-w64.cmake"
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "WGR_WEB": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux: the library and examples, with a window, GPU and audio",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux/release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux/debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-headless",
      "displayName": "Linux headless: unit tests, guardrails and a smoke run of every example",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/linux/headless",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux headless under ThreadSanitizer",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/linux/tsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "WGR_SANITIZE": "thread",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux headless under AddressSanitizer",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/linux/asan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "WGR_SANITIZE": "address",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Linux headless under UndefinedBehaviorSanitizer",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/linux/ubsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "WGR_SANITIZE": "undefined",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS: the library and examples, with a window, GPU and audio",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macos/release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS, debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macos/debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-headless",
      "displayName": "macOS headless: unit tests, guardrails and a smoke run of every example",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/macos/headless",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-tsan",
      "displayName": "macOS headless under ThreadSanitizer",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/macos/tsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "WGR_SANITIZE": "thread",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "macOS headless under AddressSanitizer",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/macos/asan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "WGR_SANITIZE": "address",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "macos-ubsan",
      "displayName": "macOS headless under UndefinedBehaviorSanitizer",
      "inherits": "headless-base",
      "binaryDir": "${sourceDir}/build/macos/ubsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "WGR_SANITIZE": "undefined",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows, MSVC (static runtime)",
      "inherits": [
        "msvc-base",
        "base"
      ],
      "binaryDir": "${sourceDir}/build/windows/msvc"
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows, MSVC, debug (static runtime)",
      "inherits": [
        "msvc-base",
        "base"
      ],
      "binaryDir": "${sourceDir}/build/windows/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug"
      }
    },
    {
      "name": "windows-msvc-headless",
      "displayName": "Windows headless, MSVC: unit tests, guardrails and a smoke run",
      "inherits": [
        "msvc-base",
        "headless-base"
      ],
      "binaryDir": "${sourceDir}/build/windows/msvc-headless"
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows, MinGW-w64 (cross-built from Linux or macOS, or gcc on Windows)",
      "inherits": [
        "mingw-base",
        "base"
      ],
      "binaryDir": "${sourceDir}/build/windows/mingw"
    },
    {
      "name": "windows-mingw-headless",
      "displayName": "Windows headless, MinGW-w64 (under Wine when cross-built)",
      "inherits": [
        "mingw-base",
        "headless-base"
      ],
      "binaryDir": "${sourceDir}/build/windows/mingw-headless"
    },
    {
      "name": "web-webgl2",
      "displayName": "Web, WebGL2, threaded (serve with COOP/COEP: tools/serve.py)",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web/webgl2"
    },
    {
      "name": "web-webgl2-nothreads",
      "displayName": "Web, WebGL2, no threads (any static host)",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web/webgl2-nothreads",
      "cacheVariables": {
        "WGR_WEB_THREADS": "OFF"
      }
    },
    {
      "name": "web-webgpu",
      "displayName": "Web, WebGPU, threaded (serve with COOP/COEP: tools/serve.py)",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web/webgpu",
      "cacheVariables": {
        "WGR_WEB_BACKEND": "webgpu"
      }
    },
    {
      "name": "web-webgpu-nothreads",
      "displayName": "Web, WebGPU, no threads (any static host)",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web/webgpu-nothreads",
      "cacheVariables": {
        "WGR_WEB_BACKEND": "webgpu",
        "WGR_WEB_THREADS": "OFF"
      }
    },
    {
      "name": "web-webgl2-debug",
      "displayName": "Web, WebGL2, threaded, debug: no optimization, assertions",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web/webgl2-debug",
      "cacheVariables": {
        "WGR_WEB_DEBUG": "ON"
      }
    },
    {
      "name": "web-webgl2-nothreads-debug",
      "displayName": "Web, WebGL2, no threads, debug: no optimization, assertions",
      "inherits": "web-base",
      "binaryDir": "${sourceDir}/build/web/webgl2-nothreads-debug",
      "cacheVariables": {
        "WGR_WEB_THREADS": "OFF",
        "WGR_WEB_DEBUG": "ON"
      }
    }
  ],
