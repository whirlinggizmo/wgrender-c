{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "WGR_EXAMPLES": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop: the library and examples, with a window, GPU and audio",
      "inherits": "base"
    },
    {
      "name": "debug",
      "displayName": "Desktop, debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless: unit tests, guardrails and a smoke run of every example",
      "inherits": "base",
      "cacheVariables": {
        "WGR_HEADLESS": "ON",
        "WGR_TESTS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Headless under ThreadSanitizer",
      "inherits": "headless",
      "cacheVariables": {
        "WGR_SANITIZE": "thread",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Headless under AddressSanitizer",
      "inherits": "headless",
      "cacheVariables": {
        "WGR_SANITIZE": "address",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "ubsan",
      "displayName": "Headless under UndefinedBehaviorSanitizer",
      "inherits": "headless",
      "cacheVariables": {
        "WGR_SANITIZE": "undefined",
        "WGR_EXAMPLES": "OFF"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows, cross-built with MinGW-w64 (from Linux or macOS)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/mingw-w64.cmake"
    },
    {
      "name": "windows-headless",
      "displayName": "Windows headless, cross-built with MinGW-w64 and tested under Wine",
      "inherits": "headless",
      "toolchainFile": "${sourceDir}/cmake/mingw-w64.cmake"
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "WGR_WEB": "ON"
      }
    },
    {
      "name": "web-webgl2",
      "displayName": "Web, WebGL2, threaded (serve with COOP/COEP: tools/serve.py)",
      "inherits": "web-base"
    },
    {
      "name": "web-webgl2-nothreads",
      "displayName": "Web, WebGL2, no threads (any static host)",
      "inherits": "web-base",
      "cacheVariables": {
        "WGR_WEB_THREADS": "OFF"
      }
    },
    {
      "name": "web-webgpu",
      "displayName": "Web, WebGPU, threaded",
      "inherits": "web-base",
      "cacheVariables": {
        "WGR_WEB_BACKEND": "webgpu"
      }
    },
    {
      "name": "web-webgpu-nothreads",
      "displayName": "Web, WebGPU, no threads",
      "inherits": "web-base",
      "cacheVariables": {
        "WGR_WEB_BACKEND": "webgpu",
        "WGR_WEB_THREADS": "OFF"
      }
    },
    {
      "name": "web-webgl2-debug",
      "displayName": "Web, WebGL2, threaded, debug: no optimization, assertions",
      "inherits": "web-base",
      "cacheVariables": {
        "WGR_WEB_DEBUG": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-headless",
      "configurePreset": "windows-headless"
    },
    {
      "name": "web-webgl2",
      "configurePreset": "web-webgl2"
    },
    {
      "name": "web-webgl2-nothreads",
      "configurePreset": "web-webgl2-nothreads"
    },
    {
      "name": "web-webgpu",
      "configurePreset": "web-webgpu"
    },
    {
      "name": "web-webgpu-nothreads",
      "configurePreset": "web-webgpu-nothreads"
    },
    {
      "name": "web-webgl2-debug",
      "configurePreset": "web-webgl2-debug"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 16
      }
    },
    {
      "name": "headless",
      "inherits": "base",
      "configurePreset": "headless"
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "configurePreset": "ubsan"
    },
    {
      "name": "windows-headless",
      "inherits": "base",
      "configurePreset": "windows-headless"
    }
  ]
}
