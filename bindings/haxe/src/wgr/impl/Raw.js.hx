/**
	Where `wgr_keyboard_state_t`'s fields sit, in ints from the pointer. Offsets are
	generated from the header, so a layout change moves them rather than
	silently misreading. An array field gives the index of its first element.
**/
class KeyboardStateLayout {
	public static inline var BYTES = 2324;
	public static inline var maxNumKeys = 0;
	public static inline var keys = 1; // [512]
	public static inline var pressedKey = 513;
	public static inline var pressedChar = 514;
	public static inline var numPressedKeys = 515;
	public static inline var pressedKeys = 516; // [32]
	public static inline var numPressedChars = 548;
	public static inline var pressedChars = 549; // [32]

	public static inline function read(pointer:Int, index:Int):Int
		return (Raw.host["HEAP32"] : Array<Int>)[(pointer >> 2) + index];
}
