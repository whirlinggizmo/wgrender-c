    "include",
    "src"
  ],
  "system_include": [
    "deps/sokol",
    "deps/sokol_utils",
    "deps/stb",
    "deps/fontstash",
    "deps/dr",
    "deps/cgltf"
  ],
  "std": "gnu11",
  "opt": [
    "-O2"
  ],
  "warn": [
    "-Wall",
    "-Wextra",
    "-Wno-unused-parameter"
  ],
  "desktop": {
    "linux": {
      "defines": [
        "SOKOL_GLCORE"
      ],
      "libs": [
        "GL",
        "X11",
        "Xi",
        "Xcursor",
        "Xrandr",
        "asound",
        "dl",
        "m",
        "pthread"
      ]
    },
    "linux-headless": {
      "defines": [
        "WGR_HEADLESS",
        "SOKOL_DUMMY_BACKEND"
      ],
      "libs": [
        "dl",
        "m",
        "pthread"
      ]
    },
    "macos": {
      "defines": [
        "SOKOL_GLCORE"
      ],
      "libs": [],
      "frameworks": [
        "Cocoa",
        "QuartzCore",
        "OpenGL",
        "AudioToolbox"
      ]
    },
    "macos-headless": {
      "defines": [
        "WGR_HEADLESS",
        "SOKOL_DUMMY_BACKEND"
      ],
      "libs": [
        "dl",
        "m",
        "pthread"
      ]
    },
    "windows": {
      "defines": [
        "SOKOL_GLCORE"
      ],
      "libs": [
        "opengl32",
        "gdi32",
        "user32",
        "kernel32",
        "ole32",
        "shell32",
        "winmm"
      ],
      "static": true
    },
    "windows-headless": {
      "defines": [
        "WGR_HEADLESS",
        "SOKOL_DUMMY_BACKEND"
      ],
      "libs": [],
      "static": true
    }
  },
  "web": {
    "release-threads": {
      "cflags": [
        "-O2",
        "-DSOKOL_GLES3",
        "-DNDEBUG",
        "-pthread"
      ],
      "program_cflags": [
        "-pthread"
      ],
      "ldflags": [
        "-O3",
        "--closure",
        "1",
        "-sENVIRONMENT=web,worker",
        "-sUSE_WEBGL2=1",
        "-pthread",
        "-sPTHREAD_POOL_SIZE=4",
        "-sPTHREAD_POOL_DELAY_LOAD=1",
        "-Wno-pthreads-mem-growth",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sFORCE_FILESYSTEM"
      ]
    },
